// 웹 전용 작업. Jenkins UI의 Pipeline script에도 이 내용을 그대로 사용한다.
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('Checkout web') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/dev']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/a204-eodilog/eodilog.git',
                        credentialsId: 'gitlab-repo',
                        refspec: '+refs/heads/dev:refs/remotes/origin/dev'
                    ]],
                    extensions: [
                        [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [[path: 'landing/']]],
                        [$class: 'CloneOption', shallow: true, depth: 1,
                         noTags: true, honorRefspec: true]
                    ]
                ])
            }
        }

        stage('Check landing changes') {
            steps {
                script {
                    // 마지막 성공 배포의 landing 트리와 비교한다. 얕은 체크아웃에서도 동작한다.
                    env.WEB_CHANGED = sh(returnStdout: true, script: '''#!/bin/bash
set -euo pipefail
current_tree=$(git rev-parse HEAD:landing)
deployed_tree=$(cat /srv/eodilog-web/deployed-landing-tree 2>/dev/null || true)
if [ "$current_tree" = "$deployed_tree" ]; then
  echo false
else
  echo true
fi
''').trim()
                    if (env.WEB_CHANGED == 'true') {
                        echo 'landing 변경 있음: 웹 배포를 진행합니다.'
                    } else {
                        echo 'landing 변경 없음: 웹 준비·배포를 건너뜁니다.'
                    }
                }
            }
        }

        stage('Prepare static web') {
            when {
                expression { env.WEB_CHANGED == 'true' }
            }
            steps {
                // Markdown·Jenkinsfile·환경파일은 공개 파일에 포함하지 않는다.
                sh '''#!/bin/bash
set -euo pipefail
test -s landing/oauth/kakao/index.html
mkdir .web-dist
while IFS= read -r -d '' file; do
  relative=${file#landing/}
  install -D -m 0644 "$file" ".web-dist/$relative"
done < <(find landing \
  -type d \\( -name .git -o -name node_modules -o -name ci \\) -prune -o \
  -type f \\( -iname '*.html' -o -iname '*.css' -o -iname '*.js' \
    -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
    -o -iname '*.svg' -o -iname '*.webp' -o -iname '*.ico' \
    -o -iname '*.woff' -o -iname '*.woff2' -o -iname '*.ttf' \
    -o -name robots.txt -o -name sitemap.xml \\) -print0)
test -s .web-dist/oauth/kakao/index.html
'''
            }
        }

        stage('Deploy and verify HTTPS') {
            when {
                expression { env.WEB_CHANGED == 'true' }
            }
            steps {
                // 새 버전을 완성한 뒤 링크를 전환한다. 검증 실패 시 직전 링크로 돌아간다.
                sh '''#!/bin/bash
set -euo pipefail
web_root=/srv/eodilog-web
test -d "$web_root/releases"
previous=$(readlink "$web_root/current")
release=$(mktemp -d "$web_root/releases/release.XXXXXXXX")
tar -C .web-dist -cf - . | tar -C "$release" -xf -
chmod -R u=rwX,go=rX "$release"
next_link="$web_root/.current-$BUILD_NUMBER"
ln -s "releases/$(basename "$release")" "$next_link"
mv -Tf "$next_link" "$web_root/current"
if curl --fail --silent --show-error --max-time 20 --retry 2 \
    https://eodilog.example.com/oauth/kakao -o .web-response.html \
    && cmp -s .web-dist/oauth/kakao/index.html .web-response.html; then
  git rev-parse HEAD:landing > "$web_root/.landing-tree-next"
  mv -f "$web_root/.landing-tree-next" "$web_root/deployed-landing-tree"
  printf '배포 확인 완료: %s\\n' "$(git rev-parse HEAD)"
else
  ln -s "$previous" "$next_link"
  mv -Tf "$next_link" "$web_root/current"
  echo 'HTTPS 검증 실패: 이전 배포로 복구했습니다.' >&2
  exit 1
fi
'''
            }
        }
    }
}
