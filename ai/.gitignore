.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 사진 평가용 이미지 (저작권·용량 때문에 커밋하지 않는다)
eval_data/*
# LLM 기능 평가 세트(cases.json)는 커밋한다. 실행 결과는 장소 결과처럼 커밋하지 않는다
!eval_data/preference_inference/
!eval_data/checklist_suggestion/
!eval_data/place_extraction/
# 사진 평가는 라벨과 출처만 커밋하고 이미지는 커밋하지 않는다
!eval_data/photos/
eval_data/photos/images/
eval_data/*/results/
