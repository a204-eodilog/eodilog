# 복사해서 .env(로컬) 또는 ai.env(운영, docker run --env-file)로 사용한다. 커밋하지 않는다.
# 운영 서버는 [필수] 5개만 채우면 된다. 나머지는 코드 기본값과 같아 비워도 된다.

# [필수] 백엔드와 공유하는 내부 토큰. 백엔드 AI_INTERNAL_TOKEN과 같은 값. 없으면 서버가 시작되지 않는다
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
# 로컬 개발에서만 true. 토큰 없이 시작하고 검사를 건너뛴다. 운영에서는 넣지 않는다
ALLOW_NO_INTERNAL_TOKEN=false

# [필수] GMS (OpenAI 호환). 비어 있으면 LLM 호출은 공급자 장애로 처리한다
GMS_API_KEY=
# 기본값과 같다
GMS_BASE_URL=https://llm-gateway.example.com/api.openai.com/v1
LLM_MODEL=gpt-5.6-luna

# [필수] NAVER API HUB 지역 검색(장소 검색). 비어 있으면 공급자 장애로 처리한다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [필수] 카카오 REST API 키(길찾기). 비어 있으면 공급자 장애로 처리한다
KAKAO_REST_API_KEY=

# 사진 모델(open_clip). 기본값과 같다. `uv sync --extra vision`으로 설치한다. 미설치·로드 실패면 사진 분류는 503이다
CLIP_MODEL=ViT-B-32-SigLIP2-256
CLIP_PRETRAINED=webli
# 이 유사도 이상이면 비슷한 사진으로 묶는다. 모델을 바꾸면 함께 다시 잡는다
PHOTO_SIMILARITY_THRESHOLD=0.94
# 서버 시작 때 모델을 올린다. 시작이 20초쯤 늦어지고 메모리를 2GB 이상 쓴다
# 로컬은 false로 둔다. Docker 이미지에는 true가 이미 들어 있어 운영에서는 넣지 않는다
PHOTO_MODEL_PRELOAD=false
