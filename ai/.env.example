# 복사해서 .env로 사용한다. .env는 커밋하지 않는다.

# 백엔드와 공유하는 내부 토큰. 없으면 서버가 시작되지 않는다
INTERNAL_API_TOKEN=
# 로컬 개발에서만 true. 토큰 없이 시작하고 검사를 건너뛴다. 운영에서는 켜지 않는다
ALLOW_NO_INTERNAL_TOKEN=false

# GMS (OpenAI 호환). 비어 있으면 LLM 호출은 공급자 장애로 처리한다
GMS_API_KEY=
GMS_BASE_URL=https://llm-gateway.example.com/api.openai.com/v1
LLM_MODEL=gpt-5.6-luna

# NAVER API HUB 지역 검색(장소 검색). 비어 있으면 공급자 장애로 처리한다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 REST API 키(길찾기). 비어 있으면 공급자 장애로 처리한다
KAKAO_REST_API_KEY=
