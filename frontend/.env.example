# 복사해서 .env로 저장한다. .env는 커밋하지 않는다.
# local | development | preview | production
EXPO_PUBLIC_APP_ENV=local
# Android 에뮬레이터에서 PC의 localhost는 10.0.2.2로 접속한다. 실기기는 PC의 IP를 쓴다.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# 앱 카카오 로그인 뒤 돌아올 https 주소(백엔드 KAKAO_ALLOWED_REDIRECTS·카카오 콘솔과 같은 값).
# 웹 미리보기는 비워 두면 http://localhost:8081/oauth/kakao 처럼 현재 주소를 쓴다.
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
# 동행 초대 링크를 받아 앱으로 넘겨 주는 https 주소(landing/invite). 비워 두면 앱 주소(eodilog://)를 그대로 쓴다.
# 메신저는 앱 주소를 누를 수 있게 만들어 주지 않으므로, 실제로 공유하려면 채운다. 예: https://eodilog.example.com/invite/
EXPO_PUBLIC_INVITE_URL=
# 네이버 클라우드 Maps 키(Client ID). 비워 두면 빌드는 되지만 지도가 안 뜬다. 안드로이드 패키지 com.eodilog.app를 등록한 팀 키를 쓴다.
NAVER_MAP_CLIENT_ID=
