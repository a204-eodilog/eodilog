# Java properties: unquoted values. Never commit .env.
POSTGRES_DB=eodilog
POSTGRES_USER=eodilog
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Exact registered redirect URI(s), comma-separated.
KAKAO_ALLOWED_REDIRECTS=
# At least 32 random bytes, Base64 encoded.
JWT_SECRET=
# 웹 프론트 origin을 쉼표로 지정한다(https://host[:port]). 빈 값은 교차 origin 허용 없음.
CORS_ALLOWED_ORIGINS=
# 내부 AI 서버 주소와 토큰(ai/.env의 INTERNAL_API_TOKEN과 같은 값). 비워도 서버는 뜨지만 AI 작업은 실패한다.
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=
# 사진·캡처 파일 S3 버킷과 그 버킷이 있는 리전(개발 버킷 eodilog-dev-a204는 ap-southeast-2).
STORAGE_BUCKET=
STORAGE_REGION=ap-southeast-2
# 개발용 IAM 사용자 키(해당 버킷 Put/Get/Delete·ListBucket만). EC2에서는 비우고 IAM 역할을 쓴다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Compatibility aliases: STORAGE_* wins when both are supplied. Leave aliases empty normally.
# S3_BUCKET, AWS_REGION, S3_ENDPOINT and ASSET_UPLOAD_TTL remain accepted.
STORAGE_ENDPOINT=
STORAGE_UPLOAD_URL_TTL=10m
STORAGE_MAX_BYTES=15728640
ASSET_MAX_PIXELS=40000000
ASSET_BATCH_TTL=24h
ASSET_INCOMPLETE_TTL=24h
IMAGE_MAGICK=magick
IMAGE_CONVERSION_TIMEOUT=30s
# 기상청 단기·중기예보 data.go.kr 일반 인증키(날씨 조회·날씨 대안). 비우면 날씨 요청만 503
KMA_SERVICE_KEY=
# 한국환경공단 전기자동차 충전소 정보 data.go.kr 키(편의시설 충전소). 비우면 KMA_SERVICE_KEY를 쓴다(같은 계정이면 같은 키)
# 키가 있으면 서버가 충전소를 미리 넣고 5분마다 상태를 갱신한다. 끄려면 EV_SYNC_ENABLED=false
EV_SERVICE_KEY=
EV_SYNC_ENABLED=true
# M4A/AAC 실제 길이·코덱 검사. 서버 이미지에 ffmpeg 패키지(ffprobe)를 설치한다.
FFPROBE_COMMAND=ffprobe
