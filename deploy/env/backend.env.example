# ${EODILOG_HOME}/env/backend.env로 복사한다. 커밋하지 않는다. 값은 따옴표 없이 쓴다
# SPRING_PROFILES_ACTIVE, SPRING_DATASOURCE_URL, AI_BASE_URL은 compose.prod.yaml에 있다

# db.env와 같은 값
SPRING_DATASOURCE_USERNAME=eodilog
SPRING_DATASOURCE_PASSWORD=

# 카카오 로그인(로컬 .env와 같은 카카오 앱)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 앱 eas.json의 EXPO_PUBLIC_KAKAO_REDIRECT_URI와 같은 값. 카카오 콘솔에도 등록돼 있어야 한다
KAKAO_ALLOWED_REDIRECTS=https://eodilog.example.com/oauth/kakao

# 운영용으로 새로 만든다. 로컬 값을 쓰지 않는다. 만들기: openssl rand -base64 48
JWT_SECRET=

# 앱(네이티브)은 CORS와 상관없다. 같은 도메인 웹을 위해 넣어 둔다
CORS_ALLOWED_ORIGINS=https://eodilog.example.com

# ai.env의 INTERNAL_API_TOKEN과 같은 값
AI_INTERNAL_TOKEN=

# S3 버킷. 지금은 로컬 .env와 같은 버킷·IAM 사용자 키를 쓴다(eodilog-dev-a204는 시드니 ap-southeast-2)
# 키를 비우면 EC2 IAM 역할(인스턴스 프로파일)을 쓴다. 그때는 메타데이터 홉 제한을 2로 올려야 한다
STORAGE_BUCKET=
STORAGE_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 기상청 단기·중기예보(data.go.kr). 비우면 날씨 요청만 503
KMA_SERVICE_KEY=
# 전기차 충전소(data.go.kr). 비우면 KMA_SERVICE_KEY를 쓴다
EV_SERVICE_KEY=
