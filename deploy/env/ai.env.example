# ${EODILOG_HOME}/env/ai.env로 복사한다. 커밋하지 않는다
# 운영은 아래 5개만 넣는다. ai/.env.example을 통째로 복사하면 PHOTO_MODEL_PRELOAD=false가 들어가
# 이미지의 true를 덮어쓰므로 그렇게 하지 않는다. ALLOW_NO_INTERNAL_TOKEN도 넣지 않는다

# backend.env의 AI_INTERNAL_TOKEN과 같은 값. 없으면 AI 서버가 시작되지 않는다
INTERNAL_API_TOKEN=
# GMS(LLM)
GMS_API_KEY=
# 네이버 지역 검색
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 길찾기
KAKAO_REST_API_KEY=
